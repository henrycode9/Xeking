# ── Required ──────────────────────────────────────────────────────────────────
# Gemini API key for the AI Coach hint endpoint (/api/ai-hint)
# AI Studio injects this automatically from the Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── Optional ──────────────────────────────────────────────────────────────────
# Allowed CORS origin for Socket.IO in production.
# Defaults to "*" (open) if not set — restrict this in production!
# Example: ALLOWED_ORIGIN="https://xeking.example.com"
ALLOWED_ORIGIN="*"

# Port the Express server listens on. Defaults to 3000.
PORT=3000

# The public URL of this app (used for self-referential links).
APP_URL="MY_APP_URL"
